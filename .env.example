# Telegram
BOT_TOKEN=

# Azure Speech (Pronunciation Assessment + TTS)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# LLM для грейдинга грамматики/вокабуляра и генерации diff
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# Postgres
DATABASE_URL=postgresql://bot:bot@postgres:5432/botdb

# Redis (кэш FSM-состояний aiogram)
REDIS_URL=redis://redis:6379/0

# Mini App (публичный HTTPS-домен, обязателен для Telegram WebApp)
WEBAPP_BASE_URL=https://your-domain.example.com

# Внутренний секрет для подписи session_id между ботом и webapp
SESSION_SIGNING_SECRET=change_me_to_random_64_chars
